<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Guignolee.Views.RegistrePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Guignolee.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Guignolee.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="Pink" BorderThickness="1">
                    <Image
                        Grid.Column="0"
                        Width="72"
                        Height="72"
                        AutomationProperties.Name="Illustration : une boîte de dons avec un ruban"
                        Source="ms-appx:///Assets/Images/geralt-christmas-9185561.jpg" />
                </Border>

                <TextBox Header="Donateur" Text="{x:Bind ViewModel., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                
                <TextBox Header="Contenu du don" Text="{x:Bind ViewModel., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Header="Quantite (articles)" Text="{x:Bind ViewModel., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                <ListView
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Dons, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.DonSelectionne, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DonViewModel">
                            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Lu" IsChecked="{x:Bind EstPerissable, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Enregistrer" Click="Enregistrer_Click"/>
                    <Button Content="Annuler" Click="Annuler_Click"/>
                </StackPanel>
    </ScrollViewer>
</Page>
